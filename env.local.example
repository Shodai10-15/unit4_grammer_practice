# このファイルを .env.local にコピーして値を入れてください（.env.localはGitに含めないこと）

# SupabaseプロジェクトのURLとanonキー（Supabase管理画面のSettings > API から取得）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 生徒がログインするときの合言葉（クラス共通・自由に決めてOK）
NEXT_PUBLIC_CLASS_PASSWORD=ud2025

# 教師用ダッシュボード（/teacher）の合言葉（生徒用とは別のものにする）
NEXT_PUBLIC_TEACHER_PASSWORD=sensei2025
